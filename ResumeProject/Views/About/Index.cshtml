@using ResumeProject.Models
@model About
@{
    ViewBag.Title = "About";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var fullName = (Model.FirstName + " " + Model.LastName).Trim();
    var imgSrc = string.IsNullOrWhiteSpace(Model.ImageUrl)
        ? "https://via.placeholder.com/300x300?text=Photo"
        : Model.ImageUrl;
}

<div class="container-fluid p-3">
    <div class="mb-4">
        <h2 class="h3 font-weight-bold text-dark mb-1">About</h2>
        <p class="text-muted mb-0">You can update your personal information here.</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            @TempData["Success"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    @using (Html.BeginForm("Index", "About", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <div class="row">

            @* Sol taraftaki kart *@
            <div class="col-lg-4 mb-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white border-bottom">
                        <h6 class="font-weight-bold text-primary mb-0">Live Preview</h6>
                    </div>
                    <div class="card-body p-4">
                        <div class="text-center">
                            <img id="previewImage" src="@imgSrc" alt="Profile"
                                 class="rounded-circle shadow mb-3"
                                 style="width:160px;height:160px;object-fit:cover;"
                                 onerror="this.src='https://via.placeholder.com/300x300?text=Photo'" />
                            <h5 id="previewName" class="font-weight-bold mb-1">@(string.IsNullOrEmpty(fullName) ? "Full Name" : fullName)</h5>
                            <p id="previewEmail" class="text-muted small mb-3">@Model.EMail</p>
                        </div>

                        <hr />

                        <div class="small">
                            <p class="mb-2"><strong>Phone:</strong> <span id="previewPhone" class="text-muted">@Model.PhoneNumber</span></p>
                            <p class="mb-3"><strong>Address:</strong> <span id="previewAddress" class="text-muted">@Model.Address</span></p>

                            <strong>Details:</strong>
                            <p id="previewDetails" class="text-muted mb-0 mt-1" style="white-space:pre-line;">@Model.Details</p>
                        </div>
                    </div>
                </div>
            </div>

            @* Güncelleme yapılacak alan *@
            <div class="col-lg-8">

                @* Personal Information *@
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white border-bottom">
                        <h6 class="font-weight-bold text-primary mb-0">Personal Information</h6>
                    </div>
                    <div class="card-body">
                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label for="FirstName" class="font-weight-bold small">First Name</label>
                                <input type="text" id="FirstName" name="FirstName" class="form-control" value="@Model.FirstName" />
                            </div>
                            <div class="form-group col-md-6">
                                <label for="LastName" class="font-weight-bold small">Last Name</label>
                                <input type="text" id="LastName" name="LastName" class="form-control" value="@Model.LastName" />
                            </div>
                        </div>
                        <div class="form-group mb-0">
                            <label for="Details" class="font-weight-bold small">Details</label>
                            <textarea id="Details" name="Details" class="form-control" rows="4">@Model.Details</textarea>
                        </div>
                    </div>
                </div>

                @* Bilgiler *@
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white border-bottom">
                        <h6 class="font-weight-bold text-primary mb-0">Contact Information</h6>
                    </div>
                    <div class="card-body">
                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label for="PhoneNumber" class="font-weight-bold small">Phone Number</label>
                                <input type="text" id="PhoneNumber" name="PhoneNumber" class="form-control" value="@Model.PhoneNumber" />
                            </div>
                            <div class="form-group col-md-6">
                                <label for="EMail" class="font-weight-bold small">E-mail</label>
                                <input type="email" id="EMail" name="EMail" class="form-control" value="@Model.EMail" />
                            </div>
                        </div>
                        <div class="form-group mb-0">
                            <label for="Address" class="font-weight-bold small">Address</label>
                            <input type="text" id="Address" name="Address" class="form-control" value="@Model.Address" />
                        </div>
                    </div>
                </div>

                @* Photo Alanı *@

                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white border-bottom">
                        <h6 class="font-weight-bold text-primary mb-0">Profile Photo</h6>
                    </div>
                    <div class="card-body">
                        <div class="form-group mb-0">
                            <label for="ImageUrl" class="font-weight-bold small">Image URL</label>
                            <input type="text" id="ImageUrl" name="ImageUrl" class="form-control" value="@Model.ImageUrl"
                                   placeholder="https://..." />
                            <small class="form-text text-muted">The preview on the left updates as you type.</small>
                        </div>
                    </div>
                </div>

                <div class="text-right">
                    <button type="submit" class="btn btn-success px-4 shadow-sm">Update</button>
                </div>
            </div>
        </div>
    }
</div>

<script>
    (function () {
        function $(id) { return document.getElementById(id); }

        function updateName() {
            var name = ($("FirstName").value + " " + $("LastName").value).trim();
            $("previewName").textContent = name || "Full Name";
        }

        function bind(inputId, previewId) {
            $(inputId).addEventListener("input", function () {
                $(previewId).textContent = this.value;
            });
        }

        $("FirstName").addEventListener("input", updateName);
        $("LastName").addEventListener("input", updateName);

        bind("EMail", "previewEmail");
        bind("PhoneNumber", "previewPhone");
        bind("Address", "previewAddress");
        bind("Details", "previewDetails");

        $("ImageUrl").addEventListener("input", function () {
            if (this.value.trim() !== "") {
                $("previewImage").src = this.value;
            }
        });
    })();
</script>