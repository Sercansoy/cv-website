@using ResumeProject.Models
@model List<Admin>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 font-weight-bold text-dark mb-1">Admin Panel</h2>
            <p class="text-muted small mb-0">Manage your professional Admin</p>
        </div>
        <a href="/Admin/CreateAdmin/" class="btn btn-primary btn-sm px-3 py-2">
            <i class="fas fa-plus mr-1"></i> New User
        </a>
    </div>

    <div class="card shadow-sm border-0">
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small uppercase">
                        <tr>
                            <th class="py-3 px-4">ID</th>
                            <th class="py-3 px-4">User</th>
                            <th class="py-3 px-4">Edit</th>
                            <th class="py-3 px-4 text-end" style="width: 160px;">Delete</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Count > 0)
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="px-4 fw-semibold text-dark">@item.AdminID</td>
                                    <td class="px-4 text-muted">@item.User</td>
                                    <td>
                                        <a href="/Admin/UpdateAdmin/@item.AdminID" class="btn btn-sm btn-primary"> <i class="fas fa-pencil-alt"></i> Edit</a>
                                    </td>
                                    <td>
                                        @using (Html.BeginForm("DeleteAdmin", "Admin", new { id = item.AdminID }, FormMethod.Post,
                                            new { @class = "d-inline", onsubmit = "return confirm('Delete this admin?');" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted">
                                    <p class="mb-1">No User found.</p>
                                    <small>Add your first professional admin to get started.</small>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

