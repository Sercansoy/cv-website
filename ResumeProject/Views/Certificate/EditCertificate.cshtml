@using ResumeProject.Models
@model Certificate
@{
    ViewBag.Title = "EditCertificate";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .content-wrapper {
        width: 100%;
        padding: 20px 30px;
        box-sizing: border-box;
    }

    .card {
        background: #fff;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        padding: 24px;
        max-width: 900px;
    }

    .card-title {
        font-size: 20px;
        font-weight: 600;
        margin-bottom: 20px;
        color: #333;
        border-bottom: 1px solid #eee;
        padding-bottom: 12px;
    }

    .form-group {
        margin-bottom: 16px;
    }

    .form-label {
        display: block;
        margin-bottom: 6px;
        font-weight: 500;
        color: #495057;
        font-size: 14px;
    }

    .form-control {
        width: 100%;
        padding: 8px 12px;
        font-size: 14px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        box-sizing: border-box;
        outline: none;
    }

        .form-control:focus {
            border-color: #80bdff;
            box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
        }

    textarea.form-control {
        min-height: 120px;
        resize: vertical;
    }

    .form-actions {
        margin-top: 24px;
        display: flex;
        gap: 10px;
    }

    .btn {
        padding: 8px 16px;
        font-size: 14px;
        font-weight: 500;
        border-radius: 4px;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        border: 1px solid transparent;
    }

    .btn-primary {
        background-color: #007bff;
        color: #fff;
        border-color: #007bff;
    }

        .btn-primary:hover {
            background-color: #0069d9;
        }

    .btn-secondary {
        background-color: #6c757d;
        color: #fff;
        border-color: #6c757d;
    }

        .btn-secondary:hover {
            background-color: #5a6268;
        }

    .field-validation-error {
        color: #dc3545;
        font-size: 12px;
        margin-top: 4px;
        display: block;
    }
</style>

<div class="content-wrapper">
    <div class="card">
        <h2 class="card-title">Edit Certificate</h2>

        @using (Html.BeginForm("EditCertificate", "Certificate", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(x => x.CertificateID)

            <div class="form-group">
                <label class="form-label">Description</label>
                @Html.TextBoxFor(x => x.Description, new { @class = "form-control" })
                @Html.ValidationMessageFor(x => x.Description)
            </div>

            <div class="form-group">
                <label class="form-label">Date</label>
                @Html.TextBoxFor(x => x.Date, new { @class = "form-control" })
                @Html.ValidationMessageFor(x => x.Date)
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Update Certificate</button>
                <a href="@Url.Action("Index", "Certificate")" class="btn btn-secondary">Back to Certificate</a>
            </div>
        }
    </div>
</div>

