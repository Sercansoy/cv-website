@using ResumeProject.Models
@model List<Certificate>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Timeline</title>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="/AdminLTE-3.0.4/plugins/fontawesome-free/css/all.min.css">
    <!-- Theme style -->
    <link rel="stylesheet" href="/AdminLTE-3.0.4/dist/css/adminlte.min.css">
    <link href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700" rel="stylesheet">
    <style>
        .timeline-item {
            position: relative;
            min-height: 85px;
            padding-right: 180px;
        }

        .timeline-right {
            position: absolute;
            top: 8px;
            right: 10px;
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 8px;
        }

        .timeline-buttons {
            display: flex;
            gap: 6px;
        }
    </style>
</head>
<body>
    <br />
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 font-weight-bold text-dark mb-1">Certificate</h2>
            <p class="text-muted small mb-0">Manage your professional certificate</p>
        </div>
        <a href="/Certificate/CreateCertificate/" class="btn btn-success btn-sm px-3 py-2">
            <i class="fas fa-plus mr-1"></i> New Certificate
        </a>
    </div>
    <div class="container-fluid p-3">

        <div class="timeline timeline-inverse">
            @foreach (var x in Model)
            {
                <!-- timeline item -->
                <div>
                    <i class="fas fa-award bg-primary"></i>
                    <div class="timeline-item">

                        <div class="timeline-body">
                            @x.Description
                        </div>

                        <div class="timeline-right">
                            <span class="badge bg-success">@x.Date.ToString("dd MMM yyyy", System.Globalization.CultureInfo.InvariantCulture)</span>
                            <div class="timeline-buttons">
                                <a href="/Certificate/EditCertificate/@x.CertificateID" class="btn btn-primary btn-sm">Edit</a>
                                @using (Html.BeginForm("DeleteCertificate", "Certificate", new { id = x.CertificateID }, FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('Delete this Certificate?');" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
</body>
</html>
