@using ResumeProject.Models
@model List<Message>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <!-- Google Font: Source Sans Pro -->
    <link href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700" rel="stylesheet">
</head>
<body>
    <div class="container-fluid p-3">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="h3 font-weight-bold text-dark mb-1">Messages</h2>
            </div>
        </div>

        <div class="timeline timeline-inverse">
            @foreach (var x in Model)
            {
                <div class="time-label">
                    <span class="bg-primary">@x.Date.ToString("dd MMM yyyy", System.Globalization.CultureInfo.InvariantCulture)</span>
                </div>

                <div>
                    <i class="fas fa-comments bg-warning"></i>
                    <div class="timeline-item">
                        <span class="time"><i class="far fa-user"></i> @x.Email</span>
                        <h3 class="timeline-header"><a href="#">@x.Name</a> @x.Subject</h3>
                        <div class="timeline-body">
                            @x.Messages
                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
</body>
</html>

