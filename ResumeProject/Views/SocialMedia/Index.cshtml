@using ResumeProject.Models
@model List<Social_media>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 font-weight-bold text-dark mb-1">Social Media</h2>
            <p class="text-muted small mb-0">Manage your Social Media Account</p>
        </div>
        <button type="button" class="btn btn-primary btn-sm px-3 py-2"
                data-toggle="modal" data-target="#addMediaModal">
            <i class="fas fa-plus mr-1"></i> New Social Media
        </button>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small uppercase">
                        <tr>
                            <th class="py-3 px-4">#</th>
                            <th class="py-3 px-4">Name</th>
                            <th class="py-3 px-4">Status</th>
                            <th class="py-3 px-4">Edit</th>
                            <th class="py-3 px-4">Delete</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Count > 0)
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="px-4 text-dark">@item.ID</td>
                                    <td class="px-4">@item.Name</td>
                                    <td class="px-4">@item.Status</td>
                                    <td>
                                        <a href="/SocialMedia/EditMedia/@item.ID" class="btn btn-sm btn-primary"><i class="fas fa-pencil-alt"></i> Edit</a>
                                    </td>
                                    <td>
                                        @using (Html.BeginForm("DeleteMedia", "SocialMedia", new { id = item.ID }, FormMethod.Post, 
                                            new { @class = "d-inline", onsubmit = "return confirm('Delete this Media?');" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <p class="mb-1">No social media found.</p>
                                    <small>Add your media to get started.</small>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Add Social Media Modal -->
<div class="modal fade" id="addMediaModal" tabindex="-1" role="dialog" aria-labelledby="addMediaModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content border-0 shadow">

            <div class="modal-header">
                <h5 class="modal-title font-weight-bold" id="addMediaModalLabel">New Social Media</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <form method="post" action="/SocialMedia/AddMedia/">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="form-group">
                        <label for="mediaName" class="small text-muted">Name</label>
                        <input type="text" id="mediaName" name="Name" class="form-control"
                               placeholder="e.g. LinkedIn, GitHub" required maxlength="100" />
                    </div>

                    <div class="form-group">
                        <label for="mediaLink" class="small text-muted">Link</label>
                        <input type="url" id="mediaLink" name="Link" class="form-control"
                               placeholder="https://www.linkedin.com/in/username" required />
                    </div>

                    <div class="form-group mb-0">
                        <label for="mediaIcon" class="small text-muted">Icon (Font Awesome class)</label>
                        <div class="input-group">
                            <input type="text" id="mediaIcon" name="Icon" class="form-control"
                                   placeholder="e.g. fab fa-linkedin-in" list="iconList" required />
                            <div class="input-group-append">
                                <span class="input-group-text"><i id="iconPreview" class="fas fa-question"></i></span>
                            </div>
                        </div>
                        <small class="form-text text-muted">Example: fab fa-github, fab fa-instagram</small>

                        <datalist id="iconList">
                            <option value="fab fa-linkedin-in"></option>
                            <option value="fab fa-github"></option>
                            <option value="fab fa-instagram"></option>
                            <option value="fab fa-twitter"></option>
                            <option value="fab fa-facebook-f"></option>
                            <option value="fab fa-youtube"></option>
                        </datalist>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-light btn-sm" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm px-3">
                        <i class="fas fa-save mr-1"></i> Save
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

<script>
    document.getElementById('mediaIcon').addEventListener('input', function () {
        var preview = document.getElementById('iconPreview');
        preview.className = this.value.trim() || 'fas fa-question';
    });
</script>