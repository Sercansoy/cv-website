<style>
  .contact-form-wrapper {
    max-width: 650px;
    margin-top: 40px;
  }

  .contact-form-wrapper .form-group {
    position: relative;
    margin-bottom: 28px;
  }

  .contact-form-wrapper label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: #8a8a8a;
    margin-bottom: 8px;
  }

  .contact-form-wrapper input,
  .contact-form-wrapper textarea {
    width: 100%;
    border: none;
    border-bottom: 2px solid #e0e0e0;
    padding: 10px 4px;
    font-size: 15px;
    color: #333;
    background: transparent;
    outline: none;
    transition: border-color 0.25s ease;
    font-family: inherit;
    box-sizing: border-box;
  }

  .contact-form-wrapper input:focus,
  .contact-form-wrapper textarea:focus {
    border-bottom-color: #c1622f;
  }

  .contact-form-wrapper textarea {
    resize: vertical;
    min-height: 110px;
  }

  .contact-form-wrapper .row-2 {
    display: flex;
    gap: 30px;
  }

  .contact-form-wrapper .row-2 .form-group {
    flex: 1;
  }

  .contact-form-wrapper button {
    background: #c1622f;
    color: #fff;
    border: none;
    padding: 12px 34px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    border-radius: 3px;
    cursor: pointer;
    transition: background 0.25s ease, transform 0.15s ease;
  }

  .contact-form-wrapper button:hover {
    background: #a54f24;
    transform: translateY(-1px);
  }

  .form-status {
    margin-bottom: 20px;
    padding: 12px 16px;
    border-radius: 4px;
    font-size: 14px;
    display: none;
  }

  .form-status.success {
    background: #e5f6ea;
    color: #1e7a34;
    display: block;
  }

  .form-status.error {
    background: #fde8e8;
    color: #b0362b;
    display: block;
  }

  @@media (max-width: 600px) {
    .contact-form-wrapper .row-2 {
      flex-direction: column;
      gap: 0;
    }
  }
</style>

<div class="contact-form-wrapper">

    @* If you return a message from the controller via TempData, it will show up here *@
    @if (TempData["FormSuccess"] != null)
    {
        <div class="form-status success">@TempData["FormSuccess"]</div>
    }
    @if (TempData["FormError"] != null)
    {
        <div class="form-status error">@TempData["FormError"]</div>
    }

    <form method="post">
        @Html.AntiForgeryToken()

        <div class="row-2">
            <div class="form-group">
                <label for="Name">Full Name</label>
                <input type="text" name="Name" id="Name" placeholder="Your full name" required>
            </div>
            <div class="form-group">
                <label for="Email">Email</label>
                <input type="email" name="Email" id="Email" placeholder="you@example.com" required>
            </div>
        </div>

        <div class="form-group">
            <label for="Subject">Subject</label>
            <input type="text" name="Subject" id="Subject" placeholder="Message subject" required>
        </div>

        <div class="form-group">
            <label for="Messages">Message</label>
            <textarea name="Messages" id="Messages" placeholder="Write your message here..." required></textarea>
        </div>

        <button type="submit">Send Message</button>
    </form>
</div>