<style>
  .contact-form-wrapper {
    max-width: 650px;
    margin-top: 40px;
  }

  .contact-form-wrapper .form-group {
    position: relative;
    margin-bottom: 28px;
  }

  .contact-form-wrapper label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: #8a8a8a;
    margin-bottom: 8px;
  }

  .contact-form-wrapper input,
  .contact-form-wrapper textarea {
    width: 100%;
    border: none;
    border-bottom: 2px solid #e0e0e0;
    padding: 10px 4px;
    font-size: 15px;
    color: #333;
    background: transparent;
    outline: none;
    transition: border-color 0.25s ease;
    font-family: inherit;
    box-sizing: border-box;
  }

  .contact-form-wrapper input:focus,
  .contact-form-wrapper textarea:focus {
    border-bottom-color: #c1622f;
  }

  .contact-form-wrapper textarea {
    resize: vertical;
    min-height: 110px;
  }

  .contact-form-wrapper .row-2 {
    display: flex;
    gap: 30px;
  }

  .contact-form-wrapper .row-2 .form-group {
    flex: 1;
  }

  .contact-form-wrapper button {
    background: #c1622f;
    color: #fff;
    border: none;
    padding: 12px 34px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    border-radius: 3px;
    cursor: pointer;
    transition: background 0.25s ease, transform 0.15s ease;
  }

  .contact-form-wrapper button:hover {
    background: #a54f24;
    transform: translateY(-1px);
  }

  .form-status {
    margin-bottom: 20px;
    padding: 12px 16px;
    border-radius: 4px;
    font-size: 14px;
    display: none;
  }

  .form-status.success {
    background: #e5f6ea;
    color: #1e7a34;
    display: block;
  }

  .form-status.error {
    background: #fde8e8;
    color: #b0362b;
    display: block;
  }
   .char-counter {
        text-align: right;
        font-size: 12px;
        color: #8a8a8a;
        margin-top: 6px;
   }

   .char-warning {
        display: none;
        margin-top: 6px;
        font-size: 13px;
        color: #b0362b;
   }
   .hp-field {
        position: absolute;
        left: -9999px;
        width: 1px;
        height: 1px;
        overflow: hidden;
   }

  @@media (max-width: 600px) {
    .contact-form-wrapper .row-2 {
      flex-direction: column;
      gap: 0;
    }
  }
</style>

<div class="contact-form-wrapper">

    @if (TempData["FormSuccess"] != null)
    {
        <div class="form-status success">@TempData["FormSuccess"]</div>
    }
    @if (TempData["FormError"] != null)
    {
        <div class="form-status error">@TempData["FormError"]</div>
    }

    @using (Html.BeginForm("SendMessage", "Home", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="hp-field" aria-hidden="true">
            <label for="Website">Website</label>
            <input type="text" name="Website" id="Website" tabindex="-1" autocomplete="off">
        </div>

        <div class="row-2">
            <div class="form-group">
                <label for="Name">Full Name</label>
                <input type="text" name="Name" id="Name" placeholder="Your full name" maxlength="100" required>
            </div>
            <div class="form-group">
                <label for="Email">Email</label>
                <input type="email" name="Email" id="Email" placeholder="you@example.com" maxlength="100" required>
            </div>
        </div>

        <div class="form-group">
            <label for="Subject">Subject</label>
            <input type="text" name="Subject" id="Subject" placeholder="Message subject" maxlength="100" required>
        </div>

        <div class="form-group">
            <label for="Messages">Message</label>
            <textarea name="Messages" id="Messages" placeholder="Write your message here..." required></textarea>
            <div class="char-counter"><span id="charCount">0</span> / 1000</div>
            <div class="char-warning" id="charWarning">Character limit reached. Any extra text was not added.</div>
        </div>

        <button type="submit">Send Message</button>
    }
    <script>
        (function () {
            var area = document.getElementById("Messages");
            var count = document.getElementById("charCount");
            var warn = document.getElementById("charWarning");
            var LIMIT = 1000;

            function used(text) {
                // Karakter Sayısı Hesaplama (CRLF)
                return text.replace(/\r?\n/g, "\r\n").length;
            }

            function update() {
                var text = area.value.slice(0, LIMIT);
                while (used(text) > LIMIT) {
                    text = text.slice(0, -1);
                }
                if (text !== area.value) {
                    area.value = text;
                }
                var total = used(text);
                count.textContent = total;
                warn.style.display = total >= LIMIT ? "block" : "none";
            }

            area.addEventListener("input", update);
            update();
        })();
    </script>
</div>