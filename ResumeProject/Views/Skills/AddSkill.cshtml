@using ResumeProject.Models
@model Skills

@{
    ViewBag.Title = "AddSkill";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container my-4" style="max-width: 600px;">
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <h4 class="mb-3 font-weight-bold text-dark">Add New Skill</h4>
            <hr class="mb-4" />

            @using (Html.BeginForm("AddSkill", "Skills", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <!-- Yetenek Adı -->
                <div class="form-group mb-3">
                    <label class="form-label font-weight-semibold">Skill Name</label>
                    @Html.TextBoxFor(x => x.Skill, new { @class = "form-control", placeholder = "e.g. C# Programming" })
                    @Html.ValidationMessageFor(x => x.Skill, "", new { @class = "text-danger small mt-1 d-block" })
                </div>

                <!-- İkon -->
                <div class="form-group mb-3">
                    <label class="form-label font-weight-semibold">Icon Class <span class="text-muted small">(optional)</span></label>
                    @Html.TextBoxFor(x => x.Icon, new { @class = "form-control", placeholder = "e.g. devicon-csharp-plain" })
                    <div class="form-text small">
                        Find class names at devicon.dev. Separate multiple icons with a comma.
                        Leave empty if the skill should not appear in the icon row.
                    </div>
                    @Html.ValidationMessageFor(x => x.Icon, "", new { @class = "text-danger small mt-1 d-block" })
                </div>

                <!-- Currently Learning -->
                <div class="form-check form-switch mb-4">
                    @Html.CheckBoxFor(x => x.IsLearning, new { @class = "form-check-input", id = "isLearning" })
                    <label class="form-check-label" for="isLearning">Currently learning</label>
                </div>

                <!-- Slider ve Progress Bar -->
                <div class="form-group mb-4" id="progressGroup">
                    <label class="form-label font-weight-semibold">Proficiency (%)</label>

                    <div class="d-flex align-items-center gap-3 mb-2">
                        <input type="range"
                               id="progressSlider"
                               class="form-range flex-grow-1"
                               min="0"
                               max="100"
                               step="1"
                               value="@(Model != null ? Model.Progress : 50)" />

                        @Html.TextBoxFor(x => x.Progress, new
                        {
                            @class = "form-control text-center",
                            type = "number",
                            min = "0",
                            max = "100",
                            id = "progressNumber",
                            style = "width: 80px;"
                        })
                    </div>

                    <div class="progress" style="height: 10px;">
                        <div class="progress-bar bg-primary" id="progressBar" role="progressbar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>

                    @Html.ValidationMessageFor(x => x.Progress, "", new { @class = "text-danger small mt-1 d-block" })
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <a href="/Skills/Index" class="btn btn-outline-secondary px-4">Back</a>
                    <button type="submit" class="btn btn-primary px-4">Save Skill</button>
                </div>
            }

        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var slider = document.getElementById("progressSlider");
        var number = document.getElementById("progressNumber");
        var bar = document.getElementById("progressBar");
        var learning = document.getElementById("isLearning");
        var group = document.getElementById("progressGroup");

        function updateProgress(value) {
            value = parseInt(value, 10);
            if (isNaN(value)) value = 0;
            if (value > 100) value = 100;
            if (value < 0) value = 0;

            slider.value = value;
            number.value = value;
            bar.style.width = value + "%";
            bar.setAttribute("aria-valuenow", value);
        }

        function toggleProgress() {
            if (learning.checked) {
                updateProgress(0);
                group.style.display = "none";
            } else {
                group.style.display = "";
            }
        }

        slider.addEventListener("input", function () {
            updateProgress(slider.value);
        });

        number.addEventListener("input", function () {
            updateProgress(number.value);
        });

        learning.addEventListener("change", toggleProgress);

        updateProgress(number.value || 50);
        toggleProgress();
    });
</script>