@using ResumeProject.Models
@model List<Education>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 font-weight-bold text-dark mb-1">Education</h2>
            <p class="text-muted small mb-0">Manage your educations</p>
        </div>
        <a href="/Education/AddEducation/" class="btn btn-primary btn-sm px-3 py-2">
            <i class="fas fa-plus mr-1"></i> New Education
        </a>
    </div>

    <!-- Table Card -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small uppercase">
                        <tr>
                            <th class="py-3 px-4">Title</th>
                            <th class="py-3 px-4">Sub Title</th>
                            <th class="py-3 px-4">Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Count > 0)
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="px-4 fw-semibold text-dark">@item.Title</td>
                                    <td class="px-4 text-muted">@item.SubTitle</td>
                                    <td class="px-4 text-muted">@item.Date</td>
                                    <td>
                                        <a href="/Education/EditEducation/@item.EducationID" class="btn btn-sm btn-primary"> <i class="fas fa-pencil-alt"></i> Edit</a>
                                        @using (Html.BeginForm("DeleteEducation", "Education", new { id = item.EducationID }, FormMethod.Post, 
                                            new { @class = "d-inline", onsubmit = "return confirm('Delete this Education?');" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <p class="mb-1">No education found.</p>
                                    <small>Add your educations to get started.</small>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

